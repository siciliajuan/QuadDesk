/*
 * prefsdlg.rc - Preferences dialog template, shared by QUADDESK.EXE and
 * QUADDESK.CPL. The Help button comes with the help files (v0.6, D-130).
 */
DLG_PREFS DIALOG 20, 20, 274, 176
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "QuadDesk Preferences"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Shortcuts", -1, 7, 6, 210, 100
    LTEXT           "&Up:", IDC_LABEL(0), 14, 22, 54, 8
    CONTROL         "Ctrl", IDC_CTRL(0), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 70, 21, 28, 10
    CONTROL         "Alt", IDC_ALT(0), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 21, 24, 10
    CONTROL         "Shift", IDC_SHIFT(0), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 126, 21, 30, 10
    COMBOBOX        IDC_KEY(0), 158, 20, 52, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Down:", IDC_LABEL(1), 14, 37, 54, 8
    CONTROL         "Ctrl", IDC_CTRL(1), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 70, 36, 28, 10
    CONTROL         "Alt", IDC_ALT(1), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 36, 24, 10
    CONTROL         "Shift", IDC_SHIFT(1), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 126, 36, 30, 10
    COMBOBOX        IDC_KEY(1), 158, 35, 52, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Left:", IDC_LABEL(2), 14, 52, 54, 8
    CONTROL         "Ctrl", IDC_CTRL(2), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 70, 51, 28, 10
    CONTROL         "Alt", IDC_ALT(2), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 51, 24, 10
    CONTROL         "Shift", IDC_SHIFT(2), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 126, 51, 30, 10
    COMBOBOX        IDC_KEY(2), 158, 50, 52, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Right:", IDC_LABEL(3), 14, 67, 54, 8
    CONTROL         "Ctrl", IDC_CTRL(3), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 70, 66, 28, 10
    CONTROL         "Alt", IDC_ALT(3), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 66, 24, 10
    CONTROL         "Shift", IDC_SHIFT(3), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 126, 66, 30, 10
    COMBOBOX        IDC_KEY(3), 158, 65, 52, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Sho&w/hide:", IDC_LABEL(4), 14, 82, 54, 8
    CONTROL         "Ctrl", IDC_CTRL(4), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 70, 81, 28, 10
    CONTROL         "Alt", IDC_ALT(4), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 81, 24, 10
    CONTROL         "Shift", IDC_SHIFT(4), "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 126, 81, 30, 10
    COMBOBOX        IDC_KEY(4), 158, 80, 52, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "When minimized", -1, 7, 112, 210, 26
    CONTROL         "Show &icon", IDC_SHOWICON, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 14, 124, 190, 10
    GROUPBOX        "Start-up", -1, 7, 144, 210, 26
    CONTROL         "&Start QuadDesk with Windows", IDC_STARTUP, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 14, 156, 190, 10
    DEFPUSHBUTTON   "OK", IDOK, 224, 8, 44, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 224, 26, 44, 14
END
